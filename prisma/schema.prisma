generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id          Int          @id @default(autoincrement())
  slug        String       @unique
  name        String
  title       String
  description String
  location    String?
  links       Link[]
  skills      Skill[]
  experiences Experience[]
  projects    Project[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Link {
  id        Int     @id @default(autoincrement())
  label     String
  url       String
  position  Int     @default(0)
  profileId Int
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Skill {
  id        Int     @id @default(autoincrement())
  name      String
  category  String
  position  Int     @default(0)
  profileId Int
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
  @@index([profileId])
}

model Experience {
  id           Int           @id @default(autoincrement())
  company      String
  companyUrl   String?
  position     String
  location     String?
  startDate    DateTime      @db.Date
  endDate      DateTime?     @db.Date
  sortOrder    Int           @default(0)
  profileId    Int
  profile      Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  achievements Achievement[]

  @@index([profileId])
}

model Achievement {
  id           Int        @id @default(autoincrement())
  text         String
  position     Int        @default(0)
  experienceId Int
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId])
}

model Project {
  id           Int      @id @default(autoincrement())
  name         String
  description  String
  url          String?
  technologies String[]
  position     Int      @default(0)
  profileId    Int
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}
